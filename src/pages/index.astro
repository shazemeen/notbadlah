---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Card from '../components/Card.astro';

const trust = [
  { label: "AIA Malaysia", sub: "Our principal" },
  { label: "Bursa-listed", sub: "AIA Berhad, public company" },
  { label: "75+ years", sub: "Operating in Malaysia" },
  { label: "Licensed", sub: "Registered with Bank Negara" },
];
---

<Layout
  title="not bad lah. | Get covered or build a career with AIA Malaysia"
  description="One place, two paths. Protect your income and family with a licensed AIA agent, or build a part-time or full-time career in insurance."
>
  <Nav cta={{ label: "Get covered", href: "/insure" }} />

  <!-- ===== BRAND HERO ===== -->
  <section id="hero" class="px-6" style="background: var(--bg); padding-top: clamp(140px, 18vh, 200px); padding-bottom: clamp(40px, 6vh, 64px);">
    <div class="max-w-4xl mx-auto text-center">
      <div id="hub-eyebrow" class="inline-flex items-center gap-2 mb-7" style="background: rgba(0,0,0,0.06); border-radius: 999px; padding: 5px 14px; width: fit-content;">
        <span style="width:5px;height:5px;border-radius:50%;background:var(--accent-strong);display:inline-block;"></span>
        <span style="font-size:0.72rem;font-weight:600;color:var(--muted);letter-spacing:0.06em;text-transform:uppercase;">An authorised AIA agency in Malaysia</span>
      </div>

      <h1 id="hub-h1" style="font-size: clamp(2.6rem, 9vw, 5.5rem); line-height: 1.0; letter-spacing: -0.03em; color: var(--ink); margin-bottom: 22px;">
        not bad lah<span style="color: var(--accent-strong);">.</span>
      </h1>

      <p id="hub-sub" style="font-size: clamp(1rem, 2.2vw, 1.25rem); color: var(--muted); line-height: 1.7; max-width: 540px; margin: 0 auto;">
        One place, two paths. Get protected, or build a career in insurance with a licensed AIA agent.
      </p>
    </div>
  </section>

  <!-- ===== TWO DOORS ===== -->
  <section id="doors" class="px-6 pb-8">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-5">

      <!-- Door A: Get covered -->
      <Card href="/insure" class="fade-up p-8 sm:p-10 flex flex-col" style="background: var(--bg-soft); text-decoration: none; min-height: 280px;">
        <div style="width:52px;height:52px;border-radius:14px;background:var(--accent-tint);display:flex;align-items:center;justify-content:center;margin-bottom:22px;">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 2.5 4 5.5v6c0 5 3.4 8.3 8 10 4.6-1.7 8-5 8-10v-6L12 2.5Z" stroke="var(--accent-strong)" stroke-width="1.7" stroke-linejoin="round"/>
            <path d="M8.5 12l2.4 2.4 4.6-5" stroke="var(--accent-strong)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h2 style="font-size: clamp(1.5rem, 3vw, 1.9rem); color: var(--ink); line-height: 1.15; margin-bottom: 10px;">Get covered</h2>
        <p style="font-size: 0.95rem; color: var(--muted); line-height: 1.7; margin-bottom: 24px;">
          For people who want insurance. Protect your income, your family, and your future with a real, licensed AIA agent. No pressure.
        </p>
        <span style="margin-top:auto;display:inline-flex;align-items:center;gap:8px;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:0.9rem;color:var(--ink);">
          Talk to us
          <span aria-hidden="true">&rarr;</span>
        </span>
      </Card>

      <!-- Door B: Build a career (two sub-options) -->
      <Card class="fade-up p-8 sm:p-10 flex flex-col" style="background: var(--bg-soft); min-height: 280px;">
        <div style="width:52px;height:52px;border-radius:14px;background:rgba(12,27,51,0.08);display:flex;align-items:center;justify-content:center;margin-bottom:22px;">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 20h16" stroke="var(--navy)" stroke-width="1.7" stroke-linecap="round"/>
            <rect x="5" y="12" width="3.4" height="6" rx="1" stroke="var(--navy)" stroke-width="1.7"/>
            <rect x="10.3" y="8" width="3.4" height="10" rx="1" stroke="var(--navy)" stroke-width="1.7"/>
            <rect x="15.6" y="4" width="3.4" height="14" rx="1" stroke="var(--navy)" stroke-width="1.7"/>
          </svg>
        </div>
        <h2 style="font-size: clamp(1.5rem, 3vw, 1.9rem); color: var(--ink); line-height: 1.15; margin-bottom: 10px;">Build a career</h2>
        <p style="font-size: 0.95rem; color: var(--muted); line-height: 1.7; margin-bottom: 20px;">
          For people who want to earn. Start on the side, or go all in. We train you either way.
        </p>

        <div class="flex flex-col gap-2.5" style="margin-top:auto;">
          <a href="/part-time" class="door-link" style="display:flex;align-items:center;gap:12px;padding:13px 16px;border-radius:12px;background:var(--bg);border:1px solid var(--border-2);text-decoration:none;transition:border-color 0.2s;">
            <span style="width:9px;height:9px;border-radius:50%;background:var(--brand);flex-shrink:0;"></span>
            <span style="flex:1;">
              <span style="display:block;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:0.92rem;color:var(--ink);">Side income</span>
              <span style="display:block;font-size:0.78rem;color:var(--muted-2);">Part-time with RintiZ. Keep your day job.</span>
            </span>
            <span aria-hidden="true" style="color:var(--muted-2);">&rarr;</span>
          </a>
          <a href="/full-time" class="door-link" style="display:flex;align-items:center;gap:12px;padding:13px 16px;border-radius:12px;background:var(--bg);border:1px solid var(--border-2);text-decoration:none;transition:border-color 0.2s;">
            <span style="width:9px;height:9px;border-radius:50%;background:var(--gold);flex-shrink:0;"></span>
            <span style="flex:1;">
              <span style="display:block;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:0.92rem;color:var(--ink);">Full-time career</span>
              <span style="display:block;font-size:0.78rem;color:var(--muted-2);">Next Gen Millionaire. Go all in.</span>
            </span>
            <span aria-hidden="true" style="color:var(--muted-2);">&rarr;</span>
          </a>
        </div>
      </Card>

    </div>
  </section>

  <!-- ===== TRUST STRIP ===== -->
  <section class="px-6 py-12" style="background: var(--bg);">
    <div class="max-w-4xl mx-auto fade-up">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-8 text-center">
        {trust.map((t) => (
          <div>
            <div style="font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(1rem,2vw,1.15rem);color:var(--ink);">{t.label}</div>
            <div style="font-size:0.76rem;color:var(--muted-2);margin-top:4px;line-height:1.5;">{t.sub}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Hero entrance
  gsap.timeline({ delay: 0.1 })
    .fromTo('#hub-eyebrow', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' })
    .fromTo('#hub-h1',      { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.9, ease: 'power4.out' }, '-=0.35')
    .fromTo('#hub-sub',     { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out' }, '-=0.5');

  // Scroll-triggered fade-ups (doors + trust strip), with a gentle stagger
  gsap.utils.toArray<HTMLElement>('.fade-up').forEach((el, i) => {
    gsap.fromTo(el,
      { opacity: 0, y: 40 },
      {
        opacity: 1, y: 0, duration: 0.7, ease: 'power3.out', delay: (i % 2) * 0.1,
        scrollTrigger: { trigger: el, start: 'top 90%', toggleActions: 'play none none none' }
      }
    );
  });

  // Sub-link hover accent (theme-aware)
  document.querySelectorAll<HTMLElement>('.door-link').forEach((el) => {
    el.addEventListener('mouseenter', () => { el.style.borderColor = 'var(--accent-strong)'; });
    el.addEventListener('mouseleave', () => { el.style.borderColor = 'var(--border-2)'; });
  });
</script>
